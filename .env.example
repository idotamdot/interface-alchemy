# Neon Postgres connection string used by Prisma.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Auth service URL for the branch used by this deployment.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.example

# Server-only secret used to protect Neon Auth cookies.
# Use a unique value with at least 32 characters and never expose it to client code.
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-neon-auth-cookie-secret

# Required in production for the signed UIGen application session cookie.
# Generate a unique value with at least 32 characters; 64 characters is recommended.
JWT_SECRET=replace-with-a-long-random-secret

# Required for real AI generation.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Optional. Development/test only; defaults to false and is rejected in production.
ENABLE_DEV_MOCK_PROVIDER=false
